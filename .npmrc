# Required for `npm install` to resolve at all, including on Vercel.
#
# fumadocs-core declares ~21 OPTIONAL peers -- one per framework and search
# backend it supports (waku, zod 4, @orama/core, algoliasearch, react-router,
# @tanstack/react-router, meilisearch ...). npm 11 speculatively resolves
# optional peers anyway and then hard-fails on the ones we do not satisfy:
# `waku@1.0.0-rc.4` wants react ~19.3.1 against our pinned 19.2.9 (pinned
# because @react-three/fiber caps at <19.3), and `zod 4.x` against our 3.24.2.
#
# None of those packages is actually used or installed -- verified: waku is
# absent from the tree. With this flag npm installs no peers at all, which is
# what the local install used, so the lockfile and a fresh CI install agree.
#
# Without this file the Vercel build fails at the install step and nothing
# deploys, which is exactly what happened on 2026-10-28.
legacy-peer-deps=true
